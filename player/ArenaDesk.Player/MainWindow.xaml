<Window x:Class="ArenaDesk.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArenaDesk Player Screen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing"
        StateChanged="OnStateChanged">
    <Grid>
        <Border x:Name="LockedPanel" Background="#FF080C16">
            <Grid>
                <Ellipse Width="520" Height="520" Fill="#1A6366F1"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-180,-220,0,0" />
                <Ellipse Width="420" Height="420" Fill="#1422D3EE"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-160,-180" />
                <StackPanel Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="76" Height="76" CornerRadius="24" Background="#226366F1"
                            BorderBrush="#556366F1" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="A" FontSize="36" FontWeight="Bold" Foreground="#FFA5B4FC"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ArenaDesk" Margin="0,28,0,0" FontSize="46" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="Bu kompýuter häzirki wagtda gulply" Margin="0,14,0,0" FontSize="21"
                               Foreground="#FFCBD5E1" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LockedMessageText" Text="Sessiya açylmagyna garaşylýar" Margin="0,10,0,0"
                               FontSize="15" Foreground="#FF94A3B8" HorizontalAlignment="Center" />
                    <Border Margin="0,32,0,0" Padding="18,11" CornerRadius="14" Background="#121E293B"
                            BorderBrush="#26334155" BorderThickness="1" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#FFF59E0B"
                                     Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectionText" Text="Agent bilen baglanyşylýar..."
                                       FontSize="13" Foreground="#FFCBD5E1" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ComputerCodeText" Margin="0,18,0,0" FontSize="12"
                               Foreground="#FF64748B" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="SessionPanel" Visibility="Collapsed" CornerRadius="22"
                Background="{StaticResource PanelBrush}" BorderBrush="#33475569" BorderThickness="1">
            <Grid Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SessionStatusDot" Width="8" Height="8" Fill="#FF34D399"
                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SessionStatusText" Text="SESSIÝA DOWAM EDÝÄR" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF6EE7B7" />
                    </StackPanel>
                    <TextBlock x:Name="RemainingTimeText" Text="00:00" Margin="0,5,0,0"
                               FontSize="32" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Tamamlanýar" FontSize="11" Foreground="#FF94A3B8" HorizontalAlignment="Right" />
                    <TextBlock x:Name="EndTimeText" Text="--:--" Margin="0,4,0,0" FontSize="15"
                               FontWeight="Medium" Foreground="#FFE2E8F0" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ActiveComputerCodeText" Margin="0,4,0,0" FontSize="10"
                               Foreground="#FF64748B" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
