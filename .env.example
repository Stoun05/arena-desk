# ArenaDesk local backend addresses
NEXT_PUBLIC_API_URL=http://localhost:5080
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5080/hubs/operations

# ASP.NET Core local server configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ArenaDesk__ClubName=ArenaDesk Demo Club
ArenaDesk__ComputerLimit=10
Cors__AllowedOrigins__0=http://localhost:3000

# PostgreSQL (use the same password for Compose and the API connection)
ARENA_DB_PASSWORD=replace-with-a-local-password
ConnectionStrings__ArenaDesk=Host=localhost;Port=5432;Database=arena_desk;Username=arena_desk;Password=replace-with-a-local-password

# Stage 8 authentication (replace every example secret outside local development)
Jwt__SigningKey=replace-with-a-random-key-at-least-32-characters-long
Jwt__Issuer=ArenaDesk.Api
Jwt__Audience=ArenaDesk.Web
Jwt__ExpirationHours=8
BootstrapUsers__AdministratorUsername=admin
BootstrapUsers__AdministratorPassword=Admin123!
BootstrapUsers__CashierUsername=cashier
BootstrapUsers__CashierPassword=Cashier123!

# Compose aliases for the same authentication settings
ARENA_JWT_SIGNING_KEY=replace-with-a-random-key-at-least-32-characters-long
ARENA_ADMIN_USERNAME=admin
ARENA_ADMIN_PASSWORD=Admin123!
ARENA_CASHIER_USERNAME=cashier
ARENA_CASHIER_PASSWORD=Cashier123!
