# ArenaDesk local backend addresses
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs/arena

# ASP.NET Core local server configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ArenaDesk__ClubName=ArenaDesk Demo Club
ArenaDesk__ComputerLimit=10
Cors__AllowedOrigins__0=http://localhost:3000

# PostgreSQL (use the same password for Compose and the API connection)
ARENA_DB_PASSWORD=replace-with-a-local-password
ConnectionStrings__ArenaDesk=Host=localhost;Port=5432;Database=arena_desk;Username=arena_desk;Password=replace-with-a-local-password
